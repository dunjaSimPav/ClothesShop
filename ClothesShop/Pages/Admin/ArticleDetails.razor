@page "/admin/Articles/details/{id:long}"

@using ClothesShop.Models
@using ClothesShop.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Routing
@using ClothesShop.Infrastructure 

@inject Localizer L

<h3 class="bg-info text-white text-center p-1">@L["Admin Article Details"]</h3>

@if (Article != null)
{
    <table class="table table-sm table-bordered table-striped">
        <tbody>
            <tr><th>@L["Admin Article ID"]</th><td>@Article.ArticleId</td></tr>
            <tr><th>@L["Admin Article Name"]</th><td>@Article.Name</td></tr>
            <tr><th>@L["Admin Article Description"]</th><td>@Article.Description</td></tr>
            <tr><th>@L["Admin Article Price"]</th><td>@Article.Price.ToString("#,##0.00") RSD</td></tr>
        </tbody>
    </table>

    <NavLink class="btn btn-warning" href="@UrlTypeEnum.Edit.GetAdminUrl("Articles", Article.ArticleId)">@L["Admin Edit"]</NavLink>
    <NavLink class="btn btn-secondary" href="@UrlTypeEnum.List.GetAdminUrl("Articles")">@L["Admin Back"]</NavLink>
}

@code {

    [Inject]
    public ClothesShop.Repository.IStoreRepository Repository { get; set; }

    [Parameter]
    public long Id { get; set; }

    public Article Article { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (Id > 0)
            {
                Article = await Repository.GetArticleWithDetails(Id);
            }

        }
        catch (Exception ex)
        {
            
        }
    }
}
