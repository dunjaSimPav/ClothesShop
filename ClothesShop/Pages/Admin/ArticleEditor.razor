@page "/admin/Articles/edit/{id:long}"

@page "/admin/Articles/create"

@using ClothesShop.Services
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Http
@using ClothesShop.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Routing
@using ClothesShop.Infrastructure
@using ClothesShop.Repository 
@using Microsoft.AspNetCore.Components.Forms 
@using System.Collections.Generic
@using ClothesShop.Components 
@using System.ComponentModel.DataAnnotations
@using System.IO
@using System.Diagnostics
@using System.Net.Http

@inject Localizer L
@inject IHttpContextAccessor _httpContext;

@inherits OwningComponentBase<IStoreRepository>


<style>
    div.validation-message { color: rgb(220, 53, 69); font-weight: 500; }
</style>

<h3 class="bg-@ThemeColor text-white text-center p-1">@(Id > 0 ? @L["Admin Article Edit"] : @L["Admin Article Create"])</h3>

@if (Article != null)
{


    <EditForm Model=@Article OnValidSubmit="SaveArticle" OnInvalidSubmit="OnValidationFail">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (Article.ArticleId > 0)
        {
            <div class="form-group">
                <label>@L["Admin Article ID"]</label>
                <input class="form-control" disabled value="@Article.ArticleId" />
            </div>
        }

        <div class="form-group">
            <label>@L["Admin Article Name"]</label>
            <ValidationMessage For="@(() => Article.Name)" />
            <InputText class="form-control" @bind-Value="Article.Name" />
        </div>

        <div class="form-group">
            <label>@L["Admin Article Description"]</label>
            <ValidationMessage For="@(() => Article.Description)" />
            <InputTextArea class="form-control" @bind-Value="Article.Description" />
        </div>

        <div class="form-group">
            <label>@L["Admin Article Price"] (RSD)</label>
            <ValidationMessage For="@(() => Article.Price)" />
            <InputNumber class="form-control" @bind-Value="Article.Price" />
        </div>

        <div class="form-group">
            <label>@L["Admin Article Picture"]</label>
            <ValidationMessage For="@(() => Article.Image)" />
            <img style="max-height: 256px" src="@Article.Image" />
            <InputFile id="imgSelector" class="form-control" OnChange="UploadImage" multiple="false" placeholder="@L["Choose a file"]" />
        </div>

        <button type="submit" class="btn btn-@ThemeColor" disabled="@(!CanSave)">@L["Admin Save"]</button>

        <NavLink class="btn btn-secondary" href="/admin/Articles">@L["Admin Back"]</NavLink>
    </EditForm>
}

@code {

    [Inject]
    public ClothesShop.Repository.IStoreRepository Repository { get; set; }

    [Inject]
    public NavigationManager NavManager { get; set; }

    [Inject]
    public IWebHostEnvironment WebHostEnvironment { get; set; }

    [Inject]
    public IArticleGroupItemsRepository ArticleGroupItemsRepository { get; set; }

    [Inject]
	public HttpClient HttpClient { get; set; }

    [Parameter]
    public long Id { get; set; }

    public Article Article { get; set; }

    public bool CanSave { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Id > 0)
            Article = await Repository.GetArticleWithDetails(Id);
        else
            Article = new Article()
                {
                    ArticleGroupItems = new()
                };
    }


    public async Task OnValidationFail(EditContext editContext)
    {
        await Task.Delay(10);
    }

    public async Task SaveArticle(EditContext editContext)
    {
        if (!CanSave) return;

        if(Id > 0)
        {
            await Repository.SaveArticle(Article);
        } else
        {
            await Repository.CreateArticle(Article);
        }

        await Task.Delay(300);
        NavManager.NavigateTo("/admin/Articles", forceLoad: true);
    }

    public async Task UploadImage(InputFileChangeEventArgs args)
    {
        if (args.File == null || !CanSave) return;

        CanSave = false;

        var content = new MultipartFormDataContent();
        using var stream = args.File.OpenReadStream(maxAllowedSize: 1_048_576_00); // 1 GB max size)
        content.Add(new StreamContent(stream), "image", args.File.Name);

        var cookiesDictionary = _httpContext.HttpContext.Request.Cookies;

        var request = new HttpRequestMessage(HttpMethod.Post, $"http://localhost:5000/api/upload/image")
            {
                Content = content
            };

        string cookies = string.Join("; ", cookiesDictionary.Select(c => $"{c.Key}={c.Value}"));

        request.Headers.Add("Cookie", cookies);

        var response = await HttpClient.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            // Handle error
            return;
        }

        var filePath = await response.Content.ReadAsStringAsync();

        Article.Image = filePath;
        CanSave = true;
    }

    public string ThemeColor => Id > 0 ? "warning" : "primary";
}