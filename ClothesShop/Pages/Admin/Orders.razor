@using ClothesShop.Repository
@using ClothesShop.Models
@using ClothesShop.Pages.Admin
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using ClothesShop.Services
@using ClothesShop.Infrastructure;

@page "/admin/orders"

@inject Localizer L

<div class="row w-100">
    <div class="col-md-12">
        <h5 class="font-weight-bold">@L["Pending Orders"]</h5>
        <OrderTable Shipped="false" TableTitle="@L["Pending Orders"]" />
    </div>
</div>

<div class="row w-100">
    <div class="col-md-12">
        <h5 class="font-weight-bold">@L["Shipped Orders"]</h5>
        <OrderTable Shipped="true" TableTitle="@L["Shipped Orders"]" />
    </div>
</div>

