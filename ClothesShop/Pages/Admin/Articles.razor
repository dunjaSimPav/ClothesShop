@page "/admin/Articles"
@page "/admin"

@using ClothesShop.Models
@using ClothesShop.Models.ViewModels
@using ClothesShop.Services
@using Microsoft.EntityFrameworkCore
@using ClothesShop.Infrastructure
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

@inject Localizer L

@inherits OwningComponentBase<ClothesShop.Repository.IStoreRepository>

<table class="table table-sm table-striped table-bordered">
    <thead>
        <tr>
            <th>@L["Admin Article ID"]</th>
            <th>@L["Admin Article Name"]</th>
            <th>@L["Admin Article Price"]</th>
        </tr>
    </thead>
    <tbody>
        @if (ArticleData?.Count() > 0)
        {
            @foreach (Article b in ArticleData)
            {
                <tr>
                    <td>@b.ArticleId</td>
                    <td>@b.Name</td>
                    <td>@b.Price.ToString("#,##0.00") RSD</td>

                    <td>
                        <NavLink class="btn btn-info btn-sm"
                        href="@UrlTypeEnum.Details.GetAdminUrl("Articles", b.ArticleId)">
                            @L["Admin Article Details"]
                        </NavLink>
                        <NavLink class="btn btn-warning btn-sm"
                        href="@UrlTypeEnum.Edit.GetAdminUrl("Articles", b.ArticleId)">
                            @L["Admin Article Edit"]
                        </NavLink>
                        <NavLink class="btn btn-warning btn-sm"
                        href="@UrlTypeEnum.GroupAssignments.GetAdminUrl("Articles", b.ArticleId)">
                            @L["Admin Article Assign Groups"]
                        </NavLink>

                        <button class="btn btn-danger btn-sm"
                        @onclick="@(() => DeleteArticle(b))">
                            @L["Admin Article Delete"]
                        </button>
                    </td>
                </tr>
            }
        }
        else if (!Loaded)
        {
            <tr>
                <td colspan="5" class="text-center">@L["Loading..."]</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">@L["No Articles"]</td>
            </tr>
        }
    </tbody>
</table>

<Pagination PagingInfo="PagingInfoData" OnPagingInfoChanged="OnPagingInfoChanged" />

<NavLink class="btn btn-primary" href="@UrlTypeEnum.Create.GetAdminUrl("Articles")">
    @L["Admin Article Create"]
</NavLink>


@code {
    public ClothesShop.Repository.IStoreRepository Repository => Service;

    public IEnumerable<Article> ArticleData { get; set; }

    public bool Loaded { get; set; }

    public PagingInfo PagingInfoData;

    protected override async Task OnParametersSetAsync()
    {
        await UpdateData();
    }

    public async Task UpdateData()
    {
        Loaded = false;

        PagingInfoData = new PagingInfo
            {
                CurrentPage = 1,
                ItemsPerPage = 10,
                TotalItems = await Repository.GetArticlesPaginatedAdminCount()
            };

        Loaded = true;
    }

    public async Task DeleteArticle(Article b)
    {
        await Repository.DeleteArticle(b);

        await UpdateData();
    }

    private async Task OnPagingInfoChanged(PagingInfo args)
    {
        PagingInfoData = new()
            {
                CurrentPage = args.CurrentPage,
                ItemsPerPage = args.ItemsPerPage,
                TotalItems = PagingInfoData.TotalItems
            };

        ArticleData = await Repository.GetArticlesPaginatedAdmin(PagingInfoData.CurrentPage, PagingInfoData.ItemsPerPage);
    }
}