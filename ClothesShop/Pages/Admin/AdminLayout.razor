@using ClothesShop.Services
@using Microsoft.AspNetCore.Components.Routing

@inherits LayoutComponentBase

@inject Localizer L

<div class="bg-info text-white p-2">
    <div class="container-fluid">
        <div class="row">
            <div class="col">
                <span class="navbar-brand ml-2"><NavLink class="nav-link text-white" href="/">@L["Clothes Shop - ADMIN"]</NavLink></span>
            </div>
        </div>
    </div>
</div>


<div class="container-fluid">
    <div class="row p-2">
        <div class="col-3">
            <NavLink class="btn btn-outline-primary btn-block"
                     href="/admin/Articles"
                     ActiveClass="btn-primary text-white"
                     Match="NavLinkMatch.Prefix">
                @L["Admin Articles"]
            </NavLink>
            <NavLink class="btn btn-outline-primary btn-block"
                     href="/admin/ArticleGroups"
                     ActiveClass="btn-primary text-white"
                     Match="NavLinkMatch.Prefix">
                @L["Admin Article Groups"]
            </NavLink>
            <NavLink class="btn btn-outline-primary btn-block"
                     href="/admin/orders"
                     ActiveClass="btn-primary text-white"
                     Match="NavLinkMatch.Prefix">
                @L["Admin Orders"]
            </NavLink>

            <NavLink class="btn btn-outline-primary btn-block"
                     href="/account/logout"
                     ActiveClass="btn-primary text-white"
                     Match="NavLinkMatch.Prefix">
                @L["Admin Log Out"]
            </NavLink>
        </div>
        <div class="col">
            @Body
        </div>
    </div>
</div>

