@model ClothesShop.Models.Article

<div class="col-lg-4 col-md-6 portfolio-item filter-@(Model.ArticleId)">
    <div class="portfolio-wrap">
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="@Model.Image" class="img-fluid" alt="">
        }
        else
        {
            <img src="/assets/img/portfolio/portfolio-1.jpg" class="img-fluid" alt="">
        }
        <div class="portfolio-info">
            <h4>@Model.Name</h4>
            <h5>@($"{Model.Price} RSD")</h5>
            <div class="portfolio-links">
                <form id="@Model.ArticleId" asp-controller="Cart" asp-action="Post" method="post">
                    <input type="hidden" asp-for="ArticleId" />
                    <a href="#" onclick="this.closest('form').submit();return false;"><i class="bi bi-cart"></i></a>
                </form>
            </div>
        </div>
    </div>
</div>