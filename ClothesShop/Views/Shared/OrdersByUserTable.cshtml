@model IEnumerable<ClothesShop.Models.Order>

@{
    bool canCancel = !Model.Any(x => x.Shipped);
}

@inject Localizer L

<table class="table">
    <thead>
        <tr>
            <th>
                @L["Basic Details"]
            </th>
            <th colspan="3">
                @L["Articles"]
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @($"#{item.OrderId}")<br />
                    @($"{item.Name} ({item.Email})")<br />
                    @($"{item.Address}, {item.City} ({item.Zip}), {item.Country}")<br />
                    @(item.GiftWrap ? L["Gift Wrap"] : L["No Gift Wrap"])<br />
                    @($"{L["Order Status"]}: {item.Status.Translate()}")<br />
                    @($"{L["Order Note"]}: " + (string.IsNullOrEmpty(item.Note) ? L["Order Note Empty"] : item.Note))
                </td>
                <td>

                    <table class="table">
                        <tbody>
                            @foreach (var line in item.Lines)
                            {
                                <tr>
                                    <td>@line.Article?.Name</td>
                                    <td>@("x" + line.Quantity)</td>
                                    <td>@(Math.Round(line.Quantity * line.Price, 2).ToString("#,###.00") + " RSD")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-color: transparent">
                                <td>
                                    @L["Order Total"]
                                </td>
                                <td>
                                </td>
                                <td>
                                    @(Math.Round(item.Lines.Sum(x => (x.Quantity * x.Price)), 2).ToString("#,###.00") + " RSD")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </td>
                <td>
                </td>
                @if (canCancel)
                {
                    <td class="lower-padding">
                        <div class="d-flex">
                            @if (item.Status == ClothesShop.Enums.PaymentStatus.Pending)
                            {
                                <form asp-action="Cancel" asp-controller="Order" method="post">
                                    <input type="hidden" name="OrderId" value="@item.OrderId" />
                                    <button type="submit" class="btn btn-link">
                                        <i class="fa fa-plus rotate-45"></i>
                                    </button>
                                </form>
                            }

                            @if (item.Status == ClothesShop.Enums.PaymentStatus.Failed || item.Status == ClothesShop.Enums.PaymentStatus.Pending)
                            {
                                <div>
                                    <a asp-controller="Order" asp-action="ProcessOrderGet" asp-route-orderId="@item.OrderId" class="btn btn-link">
                                        <i class="fa fa-coins"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
