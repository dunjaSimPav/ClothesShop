@model NavigationPageModel

@inject Localizer L

<nav id="navbar" class="navbar">
    <ul>
        @foreach (var entry in Model.NavigationEntries)
        {
            <li><a class="@entry.ClassList" href="@entry.FullUrl">@entry.Title</a></li>
        }
        @if (!User.IsInRole("User") && !User.IsInRole("Administrator"))
        {
            <li>
                <a class="getstarted" asp-controller="Account" asp-action="Login">@L["Get Started"]</a></li>
        }
        else
        {
            <li class="dropdown">
                <a href="#"><i class="bi bi-gear"></i></a>
                <ul class="custom">
                    <li><a asp-controller="Account" asp-action="EditProfile">@L["Profile"]</a></li>
                    <li><a asp-controller="Order" asp-action="OrdersByUser">@L["Orders"]</a></li>
                    @if (User.IsInRole("Administrator"))
                    {
                        <li><a href="/Admin">@L["Admin Panel"]</a></li>
                    }
                    <li><a asp-controller="Account" asp-action="Logout">@L["Logout"]</a></li>
                </ul>
            </li>
        }
    </ul>
    <i class="bi bi-list mobile-nav-toggle"></i>
</nav><!-- .navbar -->