@model ClothesShop.Models.ArticleGroup

<div class="col-lg-4 col-md-6 portfolio-item filter-@(Model.ArticleGroupId)"> <!-- TODO: Zameni Model.ArticleId sa trenutnom grupom artikla -->
    <div class="portfolio-wrap">
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="@Model.Image" class="img-fluid" alt="">
        }
        else
        {
            <img src="/assets/img/portfolio/portfolio-1.jpg" class="img-fluid" alt="">
        }
        <div class="portfolio-info">
            <h4>@Model.Name</h4>
            <div class="portfolio-links">
                <a href="?page=1&pageSize=12&articleGroup=@Model.ArticleGroupId"><i class="bi bi-eye"></i></a>
            </div>
        </div>
    </div>
</div>