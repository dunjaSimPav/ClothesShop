@model PagingInfo

@inject Localizer L

@if (Model.TotalPages >= 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link getstarted" href="?page=1&pageSize=12&articleGroup=@(Model.CurrentGroup)&articleSubGroup=@(Model?.CurrentSubGroup)">@L["Previous"]</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link getstarted" href="?page=@(i)&pageSize=12&articleGroup=@(Model.CurrentGroup)&articleSubGroup=@(Model?.CurrentSubGroup)">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link getstarted" href="?page=@(Model.TotalPages < Model.CurrentPage + 1 ? Model.CurrentPage + 1 : Model.TotalPages)&pageSize=12&articleGroup=@(Model.CurrentGroup)&articleSubGroup=@(Model?.CurrentSubGroup)">@L["Next"]</a>
            </li>
        </ul>
    </nav>
}