@model ArticleListViewModel

@inject Localizer L

<vc:welcome-screen />


<script src="/assets/vendor/php-email-form/validate.js"></script>

<main id="main">

    <section id="portfolio" class="portfolio">

        <div class="container" data-aos="fade-up">

            <header class="section-header">
                <h2>@L["Offers"]</h2>
                <p>@L["CheckOurAssortment"]</p>
            </header>

            @if (Model.CurrentArticleGroupId == null)
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="row gy-4 portfolio-container" data-aos="fade-up" data-aos-delay="200">
                            @foreach (var articleGroup in Model.ArticleGroups)
                            {
                                <partial name="ArticleGroupShortDetails" model="articleGroup" />
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {

                <div class="row">
                    <div class="col-md-2 sidebar">
                        @await Component.InvokeAsync("AssortmentFilter", new { ArticlesFilter = Model })
                    </div>
                    <div class="col-md-9">
                        <div class="row gy-4 portfolio-container m-b-1rem" data-aos="fade-up" data-aos-delay="200">
                            @foreach (var Article in Model.Articles)
                            {
                                <partial name="ArticleShortDetails" model="Article" />
                            }
                        </div>

                        <div class="row gy-4 portfolio-container">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-center">
                                    <partial name="_Pagination" model="Model.PagingInfo" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

    </section>

    <section id="contact" class="contact">

        <div class="container" data-aos="fade-up">

            <header class="section-header">
                <h2>@L["CONTACT"]</h2>
                <p>@L["ContactUs"]</p>
            </header>

            <div class="row gy-4">

                <div class="col-lg-12">

                    <div class="row gy-4">
                        <div class="col-md-6">
                            <div class="info-box">
                                <i class="bi bi-geo-alt"></i>
                                <h3>@L["Address"]</h3>
                                <p>Promenada BB<br>Sremska Mitrovica, 22000</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <i class="bi bi-telephone"></i>
                                <h3>@L["CallUs"]</h3>
                                <p>+381 63 190 54 23<br>+381 64 324 88 66</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <i class="bi bi-envelope"></i>
                                <h3>@L["EmailUs"]</h3>
                                <p>info@gmail.com<br>contact@gmail.com</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box">
                                <i class="bi bi-clock"></i>
                                <h3>@L["OpenHours"]</h3>
                                <p>@L["Monday"] - @L["Friday"]<br>09:00 - 17:00</p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>

</main>
