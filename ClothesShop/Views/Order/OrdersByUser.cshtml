@model OrdersByUserViewModel

@inject Localizer L

<main id="main">
    <section id="portfolio" class="portfolio p-t-90">
        <div class="container" data-aos="fade-up">

            <header class="section-header">
                <h2>@L["My Orders"]</h2>
            </header>

            <div class="row w-100">
                <div class="col-md-12">
                    <h5 class="font-weight-bold">@L["Pending Orders"]</h5>
                    <partial name="OrdersByUserTable" model="Model.Orders" />
                </div>
            </div>
            <div class="row w-100">
                <div class="col-md-12">
                    <h5 class="font-weight-bold">@L["Sent Orders"]</h5>
                    <partial name="OrdersByUserTable" model="Model.ShippedOrders" />
                </div>
            </div>
        </div>
    </section>
</main>





