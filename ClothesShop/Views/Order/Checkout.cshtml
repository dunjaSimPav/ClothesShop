@model Order

@{
    var userProfile = Model?.UserProfile ?? new UserProfile();
}

@inject Localizer L

<section class="contact p-t-90">
    <div class="container aos-init aos-animate col-md-6">

        <h2>@L["Check out now"]</h2>
        <p>@L["Please enter your details, and we'll ship your goods right away!"]</p>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="ProcessOrder" method="post" class="php-email-form">
            <h3>@L["Ship to"]</h3>
            <div class="form-group mb-3">
                <label asp-for="Name">
                    @L["Name:"]
                </label>
                <div asp-validation-for="Name" class="text-danger"></div>
                <input asp-for="Name" class="form-control" value="@userProfile.Name"/>
            </div>
            <div class="form-group">
                <label>@L["Email:"]</label><input asp-for="Email" class="form-control" value="@userProfile.Email" />
            </div>
            
            <div class="form-group">
                <label>@L["Address:"]</label><input asp-for="Address" class="form-control" value="@userProfile.Address" />
            </div>
            <div class="form-group">
                <label>@L["City:"]</label><input asp-for="City" class="form-control" value="@userProfile.City" />
            </div>
            <div class="form-group">
                <label>@L["State or Region:"]</label><input asp-for="State" class="form-control" value="@userProfile.State" />
            </div>
            <div class="form-group">
                <label>@L["Zip:"]</label><input asp-for="Zip" class="form-control" value="@userProfile.Zip" />
            </div>
            <div class="form-group">
                <label>@L["Country:"]</label><input asp-for="Country" class="form-control" value="@userProfile.Country" />
            </div>
            <h3>@L["Options"]</h3>
            <div class="checkbox">
                <label>
                    <input asp-for="GiftWrap" /> @L["Gift wrap these items"]
                </label>
            </div>
            <div class="text-center">
                <input class="btn btn-primary" type="submit" value="@L["Complete Order"]" />
            </div>
        </form>
    </div>
</section>