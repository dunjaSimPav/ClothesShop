@model Cart

@inject Localizer L

<section id="portfolio" class="portfolio cart-section">
    <div class="container aos-init aos-animate">
        <h2>@L["Your cart"]</h2>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>@L["Quantity"]</th>
                    <th>@L["Item"]</th>
                    <th class="text-right">@L["Price"]</th>
                    <th class="text-right">@L["Subtotal"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Lines)
                {
                    <tr>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-left">@item.ArticleName</td>
                        <td class="text-right">@item.Price.ToString("#,###.00") RSD</td>
                        <td class="text-right">@((item.Quantity * item.Price).ToString("#,###.00")) RSD</td>
                        <td class="text-center">
                            <form asp-controller="Cart" asp-action="Delete" method="post">
                                <input type="hidden" name="ArticleId"
                                       value="@item.ArticleId" />
                                <button type="submit" class="danger-btn">
                                    @L["Remove"]
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right">@L["Total:"]</td>
                    <td class="text-right">@Model.ComputeTotalValue().ToString("#,##0.00") RSD</td>
                </tr>
            </tfoot>
        </table>
        <div class="text-center">
            <a class="confirm-btn" asp-controller="Home" asp-action="Index" asp-fragment="portfolio">@L["Continue shopping"]</a>
            <a class="confirm-btn" asp-action="Checkout" asp-controller="Order">
                @L["Checkout"]
            </a>
        </div>
    </div>
</section>